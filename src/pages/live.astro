---
import Base from '../layouts/Base.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const defaultApiUrl = import.meta.env.PUBLIC_TRACKING_API_URL ?? '';
---
<Base title="Live position — FUSKY 55K">
<header><div class="wrap">
  <div class="kicker">FUSKY 55K • PROTECTED TRACKING</div>
  <h1>Live position</h1>
  <div class="muted">Latest available Find My report, not continuous GPS.</div>
</div></header>

<main><div class="wrap">
  <a class="back" href={baseUrl}>← Crew command</a>

  <section class="card"><div class="pad">
    <div class="eyebrow">Backend connection</div>
    <h2>Connect this device</h2>
    <div id="tracker-config" class="connect-grid" data-default-api={defaultApiUrl}>
      <div class="field"><label for="api-url">Tracking API URL</label><input id="api-url" type="url" inputmode="url" placeholder="https://tracker.example.com"></div>
      <div class="field"><label for="access-token">Crew access token</label><input id="access-token" type="password" autocomplete="off" placeholder="Shared privately with crew"></div>
      <div class="connect-actions"><button id="connect" class="button" type="button">Connect</button><span id="connection-state" class="connection-state" data-state="idle">Not connected</span></div>
    </div>
    <p class="privacy-callout">The API address is saved on this device. The access token lasts only for this browser tab and is never committed to the website.</p>
  </div></section>

  <section class="card"><div id="live-map" aria-label="Map showing latest runner position"></div></section>

  <section class="card"><div class="pad">
    <div class="live-readout">
      <div class="live-value"><span>Device</span><strong id="device-name">—</strong></div>
      <div class="live-value"><span>Report age</span><strong id="report-age">—</strong></div>
      <div class="live-value"><span>Accuracy</span><strong id="accuracy">—</strong></div>
    </div>
    <p id="reported-at" class="mini">No location received yet.</p>
    <p class="note">Find My reports can be delayed and depend on nearby Apple devices. Never use this screen as the only safety system.</p>
  </div></section>
</div></main>

<script>
import L from 'leaflet';
import track from '../data/track.json';

const config = document.querySelector<HTMLElement>('#tracker-config');
const apiInput = document.querySelector<HTMLInputElement>('#api-url');
const tokenInput = document.querySelector<HTMLInputElement>('#access-token');
const connectButton = document.querySelector<HTMLButtonElement>('#connect');
const stateNode = document.querySelector<HTMLElement>('#connection-state');
const map = L.map('live-map');
const route = L.polyline(track.map(point => [point.lat, point.lng]), { color:'#ff5a36', weight:4, opacity:.7 }).addTo(map);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  maxZoom:19,
  attribution:'© OpenStreetMap'
}).addTo(map);
map.fitBounds(route.getBounds(), { padding:[18,18] });

let marker: L.CircleMarker | undefined;
let accuracyCircle: L.Circle | undefined;
let pollTimer: number | undefined;
let firstLocation = true;
let lastReportTime: Date | undefined;

const savedApi = localStorage.getItem('fusky-tracking-api');
if (apiInput) apiInput.value = savedApi || config?.dataset.defaultApi || '';

function setState(message: string, state: 'idle' | 'loading' | 'live' | 'error') {
  if (!stateNode) return;
  stateNode.textContent = message;
  stateNode.dataset.state = state;
}

function endpointFor(base: string) {
  const clean = base.trim().replace(/\/$/, '');
  return clean.endsWith('/api/location') ? clean : `${clean}/api/location`;
}

function ageLabel(date: Date) {
  const seconds = Math.max(0, Math.round((Date.now() - date.getTime()) / 1000));
  if (seconds < 60) return `${seconds}s`;
  if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
  return `${Math.floor(seconds / 3600)}h ${Math.floor((seconds % 3600) / 60)}m`;
}

function refreshAge() {
  const node = document.querySelector('#report-age');
  if (node && lastReportTime) node.textContent = ageLabel(lastReportTime);
}

async function fetchLocation() {
  const api = apiInput?.value.trim() ?? '';
  const token = tokenInput?.value ?? '';
  if (!api || !token) {
    setState('Enter the API URL and access token.', 'error');
    return;
  }

  connectButton?.setAttribute('disabled', '');
  setState('Fetching…', 'loading');
  try {
    const response = await fetch(endpointFor(api), {
      headers: { Authorization: `Bearer ${token}` },
      cache: 'no-store'
    });
    if (!response.ok) throw new Error(response.status === 401 ? 'Access token rejected.' : `Backend returned ${response.status}.`);
    const location = await response.json();
    const point = L.latLng(location.lat, location.lon);
    const radius = location.accuracy_m ?? 0;

    if (!marker) marker = L.circleMarker(point, { radius:9, color:'#fff', weight:3, fillColor:'#6ee7a8', fillOpacity:1 }).addTo(map);
    else marker.setLatLng(point);

    if (accuracyCircle) accuracyCircle.remove();
    if (radius > 0) accuracyCircle = L.circle(point, { radius, color:'#6ee7a8', weight:1, fillOpacity:.08 }).addTo(map);
    if (firstLocation) {
      map.setView(point, 15);
      firstLocation = false;
    }

    lastReportTime = new Date(location.reported_at);
    document.querySelector('#device-name')!.textContent = location.device_name;
    document.querySelector('#accuracy')!.textContent = radius ? `±${radius} m` : 'Unknown';
    document.querySelector('#reported-at')!.textContent = `Reported ${lastReportTime.toLocaleString()} • fetched ${new Date(location.fetched_at).toLocaleTimeString()}${location.stale ? ' • STALE' : ''}`;
    refreshAge();
    localStorage.setItem('fusky-tracking-api', api);
    setState(location.stale ? 'Connected • report is stale' : 'Connected • polling every 30s', location.stale ? 'error' : 'live');
  } catch (error) {
    setState(error instanceof Error ? error.message : 'Unable to reach tracking backend.', 'error');
  } finally {
    connectButton?.removeAttribute('disabled');
  }
}

connectButton?.addEventListener('click', () => {
  if (pollTimer) window.clearInterval(pollTimer);
  void fetchLocation();
  pollTimer = window.setInterval(() => void fetchLocation(), 30_000);
});
window.setInterval(refreshAge, 5_000);
</script>
</Base>
