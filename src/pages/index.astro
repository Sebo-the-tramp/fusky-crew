---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import stops from '../data/stops.json';
const crew = (await getCollection('crew')).sort((a,b)=>a.data.priority-b.data.priority);
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const formatWindow = (start: string, end: string) => start === end ? start : `${start}–${end}`;
---
<Base title="FUSKY 55K Crew">
<header><div class="wrap">
<div class="kicker">FUSKY 55K • 03 OCT 2026</div>
<h1>Crew command</h1>
<div class="header-row"><div class="muted">Where to be, when to be there, and what each person needs to do.</div><div class="start-badge">START 09:00</div></div>
</div></header>

<main><div class="wrap">
<nav class="quick-links" aria-label="Race resources">
  <a class="quick-link" href={`${baseUrl}nutrition/`}><span>Runner plan</span><strong>Nutrition →</strong></a>
  <a class="quick-link" href={`${baseUrl}equipment/`}><span>Camera plan</span><strong>Equipment →</strong></a>
  <a class="quick-link" href={`${baseUrl}FUSKY-55K-2026.gpx`} download><span>Offline route</span><strong>Download GPX ↓</strong></a>
</nav>
<section class="card countdown-card" aria-labelledby="countdown-title">
  <div class="pad">
    <div class="eyebrow">3 October 2026 • 09:00 CEST</div>
    <h2 id="countdown-title">Race starts in</h2>
    <div id="race-countdown" class="countdown" data-start="2026-10-03T09:00:00+02:00" aria-live="polite">
      <div><strong id="countdown-days">—</strong><span>Days</span></div>
      <div><strong id="countdown-hours">—</strong><span>Hours</span></div>
      <div><strong id="countdown-minutes">—</strong><span>Minutes</span></div>
      <div><strong id="countdown-seconds">—</strong><span>Seconds</span></div>
    </div>
  </div>
</section>
<section class="card"><div id="map"></div></section>

<section id="home-live-position" class="card" hidden><div class="pad">
  <div class="eyebrow">Protected live position</div>
  <div class="live-readout">
    <div class="live-value"><span>Device</span><strong id="home-device-name">—</strong></div>
    <div class="live-value"><span>Report age</span><strong id="home-report-age">—</strong></div>
    <div class="live-value"><span>Accuracy</span><strong id="home-accuracy">—</strong></div>
  </div>
  <p id="home-reported-at" class="mini">Waiting for a location report.</p>
  <p class="note">Find My reports can be delayed. Never use this screen as the only safety system.</p>
</div></section>

<div class="desktop2">
<section class="card"><div class="pad">
<h2 style="margin-top:0">Race timeline</h2>
{stops.map(s => <div class="stop">
  <strong>{s.name}</strong>
  <span class="time">{formatWindow(s.windowStart, s.windowEnd)}</span>
  <div class="mini">km {s.km} • {s.ele} m</div>
</div>)}
</div></section>

<section class="card"><div class="pad">
<h2 style="margin-top:0">Crew</h2>
<div class="grid">
{crew.map(c => <a class="crew-card" href={`${baseUrl}crew/${c.id}/`}>
  <div class="role">{c.data.role}</div><h3>{c.data.name}</h3>
  <div class="mini">{c.data.equipment.length ? c.data.equipment.join(' • ') : 'Equipment not recorded'}</div>
  <div class="card-link">Open plan →</div>
</a>)}
</div>
</div></section>
</div>

<section class="card"><div class="pad">
<h2 style="margin-top:0">Coverage still needed</h2>
<p class="muted">These are roles to assign from the TBD crew—not necessarily more people.</p>
<div class="grid">
  <div class="crew-card"><div class="role">Critical</div><h3>Command + timing</h3><div class="mini">One person watches live timing, owns the group chat and tells every unit when to move.</div></div>
  <div class="crew-card"><div class="role">Critical</div><h3>Start + finish camera</h3><div class="mini">One person owns Cavalese: preparation, the 09:00 start and an uninterrupted finish shot.</div></div>
  <div class="crew-card"><div class="role">Critical</div><h3>Mobile course camera</h3><div class="mini">One person covers selected points on the course without trying to reach every location.</div></div>
  <div class="crew-card"><div class="role">Critical</div><h3>Dedicated drivers</h3><div class="mini">Ideally two: mountain/east-side transport and Cavalese/finish transport. Camera operators should not also coordinate every move.</div></div>
  <div class="crew-card"><div class="role">Critical</div><h3>Nutrition + gear captain</h3><div class="mini">Own labelled reload bags, bottles, clothing and the emergency reserve; verify each hand-off is race-legal.</div></div>
  <div class="crew-card"><div class="role">Optional</div><h3>Drone + media support</h3><div class="mini">Only if conditions and flight rules permit; otherwise move charged batteries, cards and backup equipment.</div></div>
</div>
</div></section>

</div></main>

<script>
import L from 'leaflet';
import track from '../data/track.json';
import stops from '../data/stops.json';

const map=L.map('map');
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);
const line=L.polyline(track.map(p=>[p.lat,p.lng]),{color:'#ff5a36',weight:4,opacity:.95}).addTo(map);
map.fitBounds(line.getBounds(),{padding:[18,18]});
stops.forEach(s=>{
  const time=s.windowStart===s.windowEnd?s.windowStart:`${s.windowStart}–${s.windowEnd}`;
  L.circleMarker([s.lat,s.lng],{radius:7,color:'#fff',weight:2,fillColor:s.kind==='film'?'#6fb7ff':s.kind==='aid'?'#6ee7a8':'#ff5a36',fillOpacity:1})
    .bindPopup(`<b>${s.name}</b><br>${time}<br>km ${s.km} • ${s.ele} m`).addTo(map)
});

const countdown = document.querySelector<HTMLElement>('#race-countdown');
const countdownTitle = document.querySelector<HTMLElement>('#countdown-title');
const raceStart = new Date(countdown?.dataset.start ?? '').getTime();

function updateCountdown() {
  const remaining = raceStart - Date.now();
  if (!Number.isFinite(raceStart)) return;
  if (remaining <= 0) {
    if (countdownTitle) countdownTitle.textContent = 'Race underway';
    countdown?.setAttribute('hidden', '');
    return;
  }

  const totalSeconds = Math.floor(remaining / 1000);
  const values = {
    days: Math.floor(totalSeconds / 86400),
    hours: Math.floor((totalSeconds % 86400) / 3600),
    minutes: Math.floor((totalSeconds % 3600) / 60),
    seconds: totalSeconds % 60
  };
  for (const [unit, value] of Object.entries(values)) {
    const node = document.querySelector(`#countdown-${unit}`);
    if (node) node.textContent = String(value).padStart(2, '0');
  }
}

updateCountdown();
window.setInterval(updateCountdown, 1_000);

const liveSection = document.querySelector<HTMLElement>('#home-live-position');
const sharedParams = new URLSearchParams(window.location.hash.slice(1));
const sharedApi = sharedParams.get('api')?.trim() ?? '';
const sharedToken = sharedParams.get('token') ?? '';
let liveMarker: L.CircleMarker | undefined;
let accuracyCircle: L.Circle | undefined;
let lastReportTime: Date | undefined;

function endpointFor(base: string) {
  const clean = base.replace(/\/$/, '');
  return clean.endsWith('/api/location') ? clean : `${clean}/api/location`;
}

function ageLabel(date: Date) {
  const seconds = Math.max(0, Math.round((Date.now() - date.getTime()) / 1000));
  if (seconds < 60) return `${seconds}s`;
  if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
  return `${Math.floor(seconds / 3600)}h ${Math.floor((seconds % 3600) / 60)}m`;
}

function refreshAge() {
  const node = document.querySelector('#home-report-age');
  if (node && lastReportTime) node.textContent = ageLabel(lastReportTime);
}

async function fetchSharedLocation() {
  try {
    const response = await fetch(endpointFor(sharedApi), {
      headers: {
        Authorization: `Bearer ${sharedToken}`,
        skip_zrok_interstitial: 'true'
      },
      cache: 'no-store'
    });
    if (!response.ok) return;

    const location = await response.json();
    if (!Number.isFinite(location.lat) || !Number.isFinite(location.lon)) return;

    const point = L.latLng(location.lat, location.lon);
    const radius = Number(location.accuracy_m) || 0;
    if (!liveMarker) {
      liveMarker = L.circleMarker(point, {
        radius: 10,
        color: '#fff',
        weight: 3,
        fillColor: '#6ee7a8',
        fillOpacity: 1
      }).bindPopup(`<b>${location.device_name}</b><br>Latest Find My report`).addTo(map);
    } else {
      liveMarker.setLatLng(point);
    }

    accuracyCircle?.remove();
    if (radius > 0) {
      accuracyCircle = L.circle(point, {
        radius,
        color: '#6ee7a8',
        weight: 1,
        fillOpacity: .08
      }).addTo(map);
    }

    lastReportTime = new Date(location.reported_at);
    document.querySelector('#home-device-name')!.textContent = location.device_name;
    document.querySelector('#home-accuracy')!.textContent = radius ? `±${radius} m` : 'Unknown';
    document.querySelector('#home-reported-at')!.textContent =
      `Reported ${lastReportTime.toLocaleString()}${location.stale ? ' • STALE' : ''}`;
    refreshAge();
    if (liveSection?.hidden) {
      liveSection.hidden = false;
      map.setView(point, 14);
    }
  } catch {
    // Invalid, unreachable, or expired share links reveal no tracking UI.
  }
}

if (sharedApi && sharedToken) {
  history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
  void fetchSharedLocation();
  window.setInterval(() => void fetchSharedLocation(), 30_000);
  window.setInterval(refreshAge, 5_000);
}
</script>
</Base>
