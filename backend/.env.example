APP_ENV=development
LOCATION_PROVIDER=mock
TRACKING_ACCESS_TOKEN=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,https://sebo-the-tramp.github.io
CACHE_SECONDS=30
STALE_AFTER_SECONDS=600
DEVICE_NAME=FUSKY tracker

# Used only when LOCATION_PROVIDER=findmy
FINDMY_ACCOUNT_PATH=secrets/account.json
FINDMY_DEVICE_PATH=secrets/device.json
FINDMY_ANISETTE_PATH=secrets/ani_libs.bin

# Used only by the mock provider
MOCK_LAT=46.29066
MOCK_LON=11.46283
MOCK_ACCURACY_M=12
